{
  "manifest_version": 3,
  "name": "Hide Paid YouTube Videos",
  "version": "1.1.0",
  "description": "Removes paywalled YouTube videos (members-only, movies to buy or rent, pay-per-view) from feeds, search and the sidebar, and skips them in Shorts.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Hide Paid Videos",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["detect.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
